{
  "index_patterns": ["its-app-logs-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "plugins.index_state_management.policy_id": "technical-logs-retention"
    },
    "mappings": {
      "properties": {
        "@timestamp": {"type": "date"},
        "timestamp": {"type": "date"},
        "level": {"type": "keyword"},
        "service": {"type": "keyword"},
        "environment": {"type": "keyword"},
        "version": {"type": "keyword"},
        "logger": {"type": "keyword"},
        "message": {"type": "text"},
        "request_id": {"type": "keyword"},
        "trace_id": {"type": "keyword"},
        "span_id": {"type": "keyword"},
        "http_status_code": {"type": "integer"},
        "duration_ms": {"type": "float"}
      }
    }
  }
}
